# ==============================================================================
# Alcove (Smart Wardrobe) — Git Ignore Configuration
# ==============================================================================

# --- Node & Frontend Dependencies & Build ---
node_modules/
*/node_modules/
dist/
dist-ssr/
build/
*.local

# --- Environment Files & Secrets ---
.env
.env.*
!.env.example
!backend/.env.example
backend/.env

# --- Python & Virtual Environments ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
ai-engine/venv/
backend/venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# --- Large AI Datasets (Raw images & splits: ~18.5 GB) ---
# Keep metadata reports, label maps, and class index JSON files
ai-engine/datasets/raw/*
!ai-engine/datasets/raw/.gitkeep
ai-engine/datasets/train/
ai-engine/datasets/validation/
ai-engine/datasets/test/

# --- Dynamic User Uploads ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor & IDE Files ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Microsoft Office Temporary Files ---
~$*.docx
~$*.pptx
~$*.xlsx

# --- Large Media / Video files (Upload to GitHub CDN instead) ---
*.mp4
*.mov
*.avi
*.wmv


